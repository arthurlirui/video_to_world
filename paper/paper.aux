\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Ablation} on the landscape scene. Removing each painting-anchored mechanism degrades stroke coherence and/or painting fidelity. Removing all controls collapses the 3D brush-stroke structure (St.\,Coh.\ $= 0.076$, strokes blur together).}}{5}{table.caption.21}\protected@file@percent }
\newlabel{tab:ablation}{{2}{5}{\textbf {Ablation} on the landscape scene. Removing each painting-anchored mechanism degrades stroke coherence and/or painting fidelity. Removing all controls collapses the 3D brush-stroke structure (St.\,Coh.\ $= 0.076$, strokes blur together)}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Camera-trajectory comparison} (landscape). Dolly and pan keep the painting in view and achieve the best painting fidelity; all four trajectories maintain $\geq 99.4$ 3D consistency.}}{5}{table.caption.23}\protected@file@percent }
