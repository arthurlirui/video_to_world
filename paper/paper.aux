\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Paint2World.} Given a single human oil painting (left), we estimate its depth, normals, and brush-stroke segmentation (Stage -1); generate a 3D-stable flythrough video whose geometry is anchored to the painting (Stage 0); non-rigidly align the generated frames into a painting-initialised canonical point cloud (Stage 1); and train a stroke-coherent 3D Gaussian Splatting scene that reproduces the painting from its viewpoint (Stage 3.2).}}{7}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:teaser}{{1}{7}{\textbf {Paint2World.} Given a single human oil painting (left), we estimate its depth, normals, and brush-stroke segmentation (Stage -1); generate a 3D-stable flythrough video whose geometry is anchored to the painting (Stage 0); non-rigidly align the generated frames into a painting-initialised canonical point cloud (Stage 1); and train a stroke-coherent 3D Gaussian Splatting scene that reproduces the painting from its viewpoint (Stage 3.2)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Pipeline overview.} Stage -1 estimates depth, normals, and brush-stroke segmentation from the painting. Stage 0 generates a 3D-stable flythrough whose per-frame geometry is constrained by a depth-warp control and whose temporal attention is biased by the painting's strokes. Stage 1 non-rigidly aligns the generated frames into a painting-initialised canonical cloud. Stage 3.2 trains a stroke-coherent 3DGS scene.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:method}{{2}{8}{\textbf {Pipeline overview.} Stage -1 estimates depth, normals, and brush-stroke segmentation from the painting. Stage 0 generates a 3D-stable flythrough whose per-frame geometry is constrained by a depth-warp control and whose temporal attention is biased by the painting's strokes. Stage 1 non-rigidly aligns the generated frames into a painting-initialised canonical cloud. Stage 3.2 trains a stroke-coherent 3DGS scene}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Painting-anchored canonical cloud.} Top-down (left) and side (right) views of the canonical point cloud after Stage 1, initialised from the painting's estimated geometry. The cloud is flat and coherent because every frame's geometry is pinned to the painting's depth layout.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{fig:results}{{3}{9}{\textbf {Painting-anchored canonical cloud.} Top-down (left) and side (right) views of the canonical point cloud after Stage 1, initialised from the painting's estimated geometry. The cloud is flat and coherent because every frame's geometry is pinned to the painting's depth layout}{figure.caption.22}{}}
